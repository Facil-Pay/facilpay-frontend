# FacilPay Dashboard — environment variable template
# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_* variables are validated with Zod at startup.
# The app throws a clear error if any required variable is missing or malformed.
#
# Usage:
#   cp .env.example .env.local
#   npm run dev

# ── API ───────────────────────────────────────────────────────────────────────
# FacilPay backend REST API base URL — no trailing slash
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ── Auth ──────────────────────────────────────────────────────────────────────
# Where to redirect after logout or on a 401 response
NEXT_PUBLIC_AUTH_LOGOUT_URL=http://localhost:3000/login

# ── Stellar network ───────────────────────────────────────────────────────────
# Network to connect to: mainnet | testnet | futurenet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon REST API endpoint for the chosen network
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for the chosen network
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Soroban contract IDs (optional — leave blank to disable) ──────────────────
NEXT_PUBLIC_PAYMENT_CONTRACT_ID=
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_REFUND_CONTRACT_ID=

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of this Next.js app (used for absolute links, QR codes, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to "true" to activate MSW mock handlers instead of hitting the real API.
# Useful for local development and Storybook without a running backend.
NEXT_PUBLIC_USE_MOCKS=true
